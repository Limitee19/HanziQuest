# OmniLife — Supabase Cloud Sync Configuration
# ⚠️ SECURITY: NEVER commit .env.local to git!
# Copy this file to .env.local and fill in your Supabase credentials
# .env.local is in .gitignore — keep it that way!

# Supabase Project URL (from Settings > API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anon Key (public, safe for browser)
# From Settings > API > anon key
# This is safe to expose in browser code (RLS enforced server-side)
VITE_SUPABASE_ANON_KEY=your-actual-anon-key-here

# ⚠️ NEVER expose SERVICE_KEY in browser code!
# SERVICE_KEY is admin access — keep it server-side only
# Do NOT set VITE_SUPABASE_SERVICE_KEY

# Master Gatekeeper PIN (Gembok Akses Web / Vercel)
# Masukkan 4-8 digit angka (contoh: 888888) agar web Vercel Anda terkunci khusus untuk Anda.
# Jika diisi, pengunjung WAJIB memasukkan PIN ini sebelum aplikasi dan database terbuka.
# ⚠️ For Vercel: Set this in Vercel Environment Variables, NOT in .env.local
VITE_APP_MASTER_PIN=

# DEPLOYMENT CHECKLIST:
# 1. Generate new Supabase keys (Settings > API > Regenerate)
# 2. Remove .env.local from git: git rm --cached .env.local
# 3. Set env vars in Vercel dashboard (Settings > Environment Variables)
# 4. Enable RLS on user_scoped tables in Supabase
# 5. Run npm run build and test locally before deploying

