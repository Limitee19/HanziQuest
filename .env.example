# OmniLife — Supabase Cloud Sync Configuration
# Copy this file to .env.local and fill in your Supabase credentials

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-actual-anon-key-here

# Master Gatekeeper PIN (Gembok Akses Web / Vercel)
# Masukkan 4-8 digit angka (contoh: 888888) agar web Vercel Anda terkunci khusus untuk Anda.
# Jika diisi, pengunjung WAJIB memasukkan PIN ini sebelum aplikasi dan database terbuka.
VITE_APP_MASTER_PIN=
